{
  "title": "Run platform",
  "uid": "run-platform",
  "description": "Apps on the run platform. Requests, errors, latency and pods per Knative service (queue-proxy and autoscaler metrics), and queue backlog per KEDA ScaledJob/ScaledObject.",
  "tags": [
    "knative",
    "keda",
    "run"
  ],
  "timezone": "browser",
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "schemaVersion": 39,
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus"
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(kube_resourcequota{resourcequota=\"tenant\"}, namespace)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Requests per second",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (namespace, kn_service_name) (rate(http_server_request_duration_seconds_count{container=\"queue-proxy\", namespace=~\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "{{namespace}}/{{kn_service_name}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Server errors (5xx share)",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (namespace, kn_service_name) (rate(http_server_request_duration_seconds_count{container=\"queue-proxy\", namespace=~\"$namespace\", http_response_status_code=~\"5..\"}[$__rate_interval])) / sum by (namespace, kn_service_name) (rate(http_server_request_duration_seconds_count{container=\"queue-proxy\", namespace=~\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "{{namespace}}/{{kn_service_name}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latency, 95th percentile",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (namespace, kn_service_name, le) (rate(http_server_request_duration_seconds_bucket{container=\"queue-proxy\", namespace=~\"$namespace\"}[$__rate_interval])))",
          "legendFormat": "{{namespace}}/{{kn_service_name}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Pods (ready) and pods wanted by the autoscaler",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (k8s_namespace_name, kn_service_name) (kn_revision_pods_count{k8s_namespace_name=~\"$namespace\"})",
          "legendFormat": "{{k8s_namespace_name}}/{{kn_service_name}} ready"
        },
        {
          "refId": "B",
          "expr": "sum by (k8s_namespace_name, kn_service_name) (kn_revision_pods_desired{k8s_namespace_name=~\"$namespace\"})",
          "legendFormat": "{{k8s_namespace_name}}/{{kn_service_name}} wanted"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Requests waiting in the activator (scale from zero)",
      "description": "Requests the activator is holding while it waits for a pod. Non-zero for a moment on every cold start.",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (k8s_namespace_name, kn_service_name) (kn_revision_request_queued{k8s_namespace_name=~\"$namespace\"})",
          "legendFormat": "{{k8s_namespace_name}}/{{kn_service_name}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Memory per revision",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (namespace, revision) (label_replace(container_memory_working_set_bytes{container!=\"\", namespace=~\"$namespace\", pod=~\".+-deployment-.+\"}, \"revision\", \"$1\", \"pod\", \"(.+)-deployment-.+\"))",
          "legendFormat": "{{namespace}}/{{revision}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Queue backlog (KEDA trigger value)",
      "description": "What each ScaledJob/ScaledObject's trigger last read, e.g. pending rows in the jobs table.",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (namespace, scaledObject, type) (keda_scaler_metrics_value{namespace=~\"$namespace\"})",
          "legendFormat": "{{namespace}}/{{scaledObject}} ({{type}})"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Jobs running",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (namespace) (kube_job_status_active{namespace=~\"$namespace\"})",
          "legendFormat": "{{namespace}}"
        }
      ]
    }
  ]
}
