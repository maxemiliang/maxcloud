# Copy to .env (gitignored) and fill in. mise loads it automatically in this repo.
# Lines stay commented until the step that needs them.

# UpCloud API: prefer `upctl account login --with-token` (system keyring, read
# by both upctl and the tofu provider). Use this only if the keyring is unavailable.
# UPCLOUD_TOKEN=

# Step 2+: passphrase for OpenTofu state encryption (all stacks, min 16 chars).
# Keep a copy in your password manager: without it, state can't be decrypted.
# TF_VAR_state_passphrase=

# Step 3: S3 backend credentials for tofu state (from infra/bootstrap outputs)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Step 3: who may reach the Kubernetes API (HCL list syntax). Kept out of git
# because it's your home IP. Single quotes are required (mise strips inner quotes otherwise).
# TF_VAR_admin_cidrs='["203.0.113.7/32"]'
