{
  "name": "maxcloud-console",
  "version": "0.1.0",
  "private": true,
  "description": "maxcloud's web console: a read-only view of your apps, with your own login's rights",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "CONSOLE_MOCK=1 nuxt dev",
    "build": "nuxt build",
    "start": "node .output/server/index.mjs",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:parity": "vitest run --config vitest.parity.config.ts"
  },
  "dependencies": {
    "nuxt": "^4.6.4",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
