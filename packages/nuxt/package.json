{
  "name": "@max-cloud/nuxt",
  "version": "0.1.0",
  "description": "Nuxt on maxcloud, the homelab's run platform: runtimeConfig from the platform's environment, and the app as a maxcloud function",
  "keywords": ["nuxt", "nuxt-module", "nitro", "knative", "maxcloud"],
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxemiliang/maxcloud.git",
    "directory": "packages/nuxt"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/module.d.ts",
      "default": "./dist/module.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@max-cloud/functions": "^0.5.0",
    "@nuxt/kit": "^4.0.0",
    "scule": "^1.3.0",
    "yaml": "^2.8.0"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.40.0",
    "nuxt": "^4.0.0",
    "unstorage": "^1.16.0"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": { "optional": true },
    "unstorage": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "drizzle-orm": "^0.45.4",
    "nuxt": "^4.6.4",
    "typescript": "^7.0.2",
    "unstorage": "^1.17.6"
  }
}
